def sanitize(d):
    sanitized = {}
    for key, value in d.items():
        if hasattr(value, "tolist") and callable(value.tolist):
            sanitized[key] = value.tolist()
        elif isinstance(value, dict):
            sanitized[key] = sanitize(value)
        else:
            sanitized[key] = value
    return sanitized

@nnx.jit
def train_step(model, optimizer, x, y):
    def loss_fn(model):
        preds = model(x)
    
        {{ loss_calculation_code | safe }}
        
        return loss, preds

    (loss, preds), grads = nnx.value_and_grad(loss_fn, has_aux=True)(model)    
    optimizer.update(model, grads)
    
    metrics_dict = {"loss": loss}
    
    {% for calc in metric_calcs %}
    {{ calc | safe }}
    {% endfor %}
    
    {% for assign in metric_assigns %}
    {{ assign | safe }}
    {% endfor %}

    return metrics_dict

print("Starting Training", flush=True)
for epoch in range(EPOCHS):
    batch_metrics_list = []
    
    for x, y in data:
        step_metrics = train_step(model, optimizer, x, y)
        batch_metrics_list.append(step_metrics)
    
    epoch_means = jax.tree.map(lambda *xs: jnp.stack(xs).mean(), *batch_metrics_list)
    
    final_metrics = {"epoch": epoch + 1}
    final_metrics.update(sanitize(epoch_means))
    
    print(json.dumps(final_metrics), flush=True)

print(json.dumps({"status": "completed"}), flush=True)